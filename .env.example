# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# Telegram Notifications Configuration (Free)
# 1. Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 2. Add the bot to your channel and make it admin
# 3. Get your channel or chat ID (e.g., -100xxxxxxxxx or @channelname)
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id
